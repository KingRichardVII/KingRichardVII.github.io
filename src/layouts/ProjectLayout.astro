---
/*
===============================================================================
                        PROJECT CASE-STUDY LAYOUT
===============================================================================

This layout controls the shared design for detailed project pages.

DO NOT duplicate this layout for each project.

Future project pages should be created under:

    src/pages/projects/

Example:

    src/pages/projects/infrastructure-homelab.astro
    src/pages/projects/active-directory.astro
    src/pages/projects/splunk-detection-lab.astro

A project page will import THIS layout and provide its own content.

-------------------------------------------------------------------------------
HOW TO ADD A NEW PROJECT CASE STUDY
-------------------------------------------------------------------------------

1. Add the project to:

       src/data/projects.ts

2. Create:

       src/pages/projects/project-name.astro

3. Import this layout:

       import ProjectLayout from "../../layouts/ProjectLayout.astro";

4. Add the project metadata:

       title
       description
       status
       tags
       heroImage
       githubUrl

5. Put screenshots under:

       public/projects/project-name/

Example:

       public/projects/homelab/
           thumbnail.webp
           architecture.webp
           proxmox-dashboard.webp
           ubuntu-server.webp
           ssh-session.webp

6. Update `href` in:

       src/data/projects.ts

Example:

       href: "/projects/infrastructure-homelab"

===============================================================================
*/

import BaseLayout from "./BaseLayout.astro";

interface Props {
    title: string;
    description: string;
    status?: string;
    tags?: string[];
    heroImage?: string;
    githubUrl?: string;
    liveUrl?: string;
}

const {
    title,
    description,
    status,
    tags = [],
    heroImage,
    githubUrl,
    liveUrl,
} = Astro.props;
---

<BaseLayout
    title={`${title} | Richard Phan`}
    sideBarActiveItemID="projects"
>
    <article>
        <!-- Back navigation -->
        <a
            href="/projects"
            class="
                inline-block
                mb-8
                opacity-70
                transition-all
                duration-200
                hover:opacity-100
                hover:-translate-x-1
            "
        >
            ← Back to Projects
        </a>


        <!-- Project header -->
        <header class="mb-10">
            <div class="flex flex-wrap items-center gap-3">
                <h1 class="text-4xl md:text-5xl font-bold">
                    {title}
                </h1>

                {
                    status && (
                        <span class="badge badge-primary rounded-full">
                            {status}
                        </span>
                    )
                }
            </div>

            <p
                class="
                    text-xl
                    mt-4
                    max-w-3xl
                    opacity-80
                    leading-relaxed
                "
            >
                {description}
            </p>


            <!-- Technology tags -->
            {
                tags.length > 0 && (
                    <div class="mt-5 flex flex-wrap gap-2">
                        {tags.map((tag) => (
                            <span class="badge badge-outline rounded-full">
                                {tag}
                            </span>
                        ))}
                    </div>
                )
            }


            <!-- Project links -->
            {
                (githubUrl || liveUrl) && (
                    <div class="mt-6 flex flex-wrap gap-3">

                        {
                            githubUrl && (
                                <a
                                    href={githubUrl}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="btn btn-outline rounded-xl"
                                >
                                    View on GitHub ↗
                                </a>
                            )
                        }

                        {
                            liveUrl && (
                                <a
                                    href={liveUrl}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="btn btn-primary rounded-xl"
                                >
                                    Live Project ↗
                                </a>
                            )
                        }

                    </div>
                )
            }
        </header>


        <!-- Main project image -->
        {
            heroImage && (
                <div
                    class="
                        mb-12
                        rounded-2xl
                        overflow-hidden
                        border
                        border-base-300
                        bg-base-200
                    "
                >
                    <img
                        src={heroImage}
                        alt={`${title} project overview`}
                        class="w-full h-auto"
                    />
                </div>
            )
        }


        <!--
        ===============================================================
                         PROJECT-SPECIFIC CONTENT
        ===============================================================

        Everything written inside <ProjectLayout> on an individual
        project page will appear here.

        Recommended project sections:

            Overview
            Objective
            Architecture
            Technologies
            Implementation
            Screenshots / Evidence
            Challenges & Troubleshooting
            Security Considerations
            Lessons Learned
            Future Improvements

        ===============================================================
        -->

        <div class="project-content">
            <slot />
        </div>

    </article>
</BaseLayout>

<style>
    .project-content :global(section) {
        margin-bottom: 3rem;
    }

    .project-content :global(h2) {
        font-size: 1.875rem;
        font-weight: 700;
        margin-bottom: 1rem;
    }

    .project-content :global(h3) {
        font-size: 1.25rem;
        font-weight: 700;
        margin-top: 1.5rem;
        margin-bottom: 0.75rem;
    }

    .project-content :global(p) {
        line-height: 1.75;
        margin-bottom: 1rem;
        opacity: 0.85;
    }

    .project-content :global(img) {
        border-radius: 1rem;
    }
</style>